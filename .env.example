# ─────────────────────────────────────────────────────────────
# CLAWKIT — every environment variable, placeholder values only.
# Copy to .env (root, used by docker-compose) and fill real values.
# URLs never end in a trailing slash.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
# Port the API listens on (Render injects its own PORT)
PORT=5001
# Neon pooled connection string (used at runtime)
DATABASE_URL=postgresql://clawkit:clawkit@localhost:5432/clawkit?schema=public
# Neon direct (non-pooled) connection string (used by prisma migrate)
DIRECT_URL=postgresql://clawkit:clawkit@localhost:5432/clawkit?schema=public
# Canonical browser origin of the website (apex, no www) — used for CORS and email links
CLIENT_URL=http://localhost:3000
# Public origin of this API
SERVER_PUBLIC_URL=http://localhost:5001
# true in production behind Render's proxy to redirect http → https
FORCE_HTTPS=false

# JWT secrets: at least 32 random chars each, and different from each other
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-hex-chars-access-secret
JWT_REFRESH_SECRET=replace-with-64-hex-chars-refresh-secret
# Access token lifetime (kept in memory on the client)
JWT_ACCESS_EXPIRY=15m
# Refresh token lifetime (httpOnly cookie, rotated on refresh)
JWT_REFRESH_EXPIRY=7d

# SMTP for contact notifications and password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
# Gmail: use an App Password, not your account password
SMTP_PASS=replace-with-smtp-password
FROM_EMAIL=hello@clawkit.us
FROM_NAME=CLAWKIT

# Seeded admin account (node prisma/seed.js). Contact form notifications go here too.
ADMIN_EMAIL=admin@clawkit.us
# At least 12 chars; seed refuses the example value in production
ADMIN_PASSWORD=change-me-strong-password

# ── Client (Next.js) ─────────────────────────────────────────
# Browser-facing API base URL, including /api/v1
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1
# Canonical site origin, used for metadataBase, sitemap and robots
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Store listing URLs for the Download Now buttons
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXXX
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.example.clawkit
